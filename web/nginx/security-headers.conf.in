# Security headers for the browser vault, included in every location
# (add_header in a location replaces inherited ones). This is a template:
# web/nginx/csp-hash.py fills __SCRIPT_HASHES__ from the inline <script> in
# the built index.html, so the script hash cannot drift from the page. Do not
# edit a generated copy; edit this template or the script.
#
# Why a generated CSP where the marketing site also generates one: the web
# bundle's index.html carries a small inline boot module (it picks WebGPU or
# WebGL2 and starts app.js). That body is static, but a hand-written hash
# would break silently the day scripts/web-build.sh rewrites the page. The
# hash is cheap to compute at image build time and keeps script-src free of
# 'unsafe-inline'.
#
# style-src does allow inline styles, unlike script-src. The page has a static
# inline <style> for the loading screen, and Rune's web platform writes a
# style attribute on its panic/error label. Blocking those would leave the
# error overlay unstyled; CSS is not an exfiltration path for this bundle.
#
# The bundle's own assets are all same-origin. Three external sources are
# admitted by name, for sync (#240 slices 8-9):
# - script-src accounts.google.com: Google Identity Services' client, loaded
#   lazily on the first Drive Connect. It sends CORP: cross-origin, so
#   require-corp below still admits it.
# - connect-src api.github.com: the GitHub PAT transport's data plane.
# - connect-src Google's Drive hosts: the Drive API, the resumable upload and
#   the access-token refresh.
# No wildcard and no 'unsafe-inline' for scripts.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com __SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.github.com https://www.googleapis.com https://oauth2.googleapis.com; media-src 'self' blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Frame-Options "DENY" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
# COOP is same-origin-allow-popups, not same-origin, because Google Identity
# Services' Drive sign-in is a popup that talks back to this page through
# `window.opener`; COOP same-origin severs that and the popup cannot report a
# token. The cost is honest and documented: `crossOriginIsolated` is then
# false, so the sync worker's Atomics sleeper uses its bounded-spin fallback
# (page_sync's seen) instead of SharedArrayBuffer. WebGPU does not need
# isolation (the bundle works without it), and no other feature here does.
add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
add_header Cross-Origin-Embedder-Policy "require-corp" always;
add_header Cross-Origin-Resource-Policy "same-origin" always;
