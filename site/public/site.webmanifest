{
  "name": "Muninn",
  "short_name": "Muninn",
  "description": "A local-first Markdown vault with [[wikilinks]] and a knowledge graph.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#080808",
  "theme_color": "#080808",
  "icons": [
    {
      "src": "/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any"
    },
    {
      "src": "/icon-192x192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/icon-512x512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ]
}
