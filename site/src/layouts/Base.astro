---
/*
  Muninn marketing page, live at https://muninn.ravenwoodsoftware.dev (deployed with GoForge).
  Theme tokens: rune-theme-opencode (anomalyco/rune @ b39c24f7), as pinned by muninn main 847f1aa.
  Base layout for the Astro port (W1): the <head> of the old static site/index.html, plus W8
  per-page og:image / og:image:alt. Prop names match W3's Base.astro override so the two
  slices compose when W3 merges; this file does not take on W3's favicons, canonical or CSP.
*/
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

export const SITE_ORIGIN = 'https://muninn.ravenwoodsoftware.dev';
const DEFAULT_TITLE = 'Muninn — a local-first Markdown vault with a knowledge graph';
const DEFAULT_DESCRIPTION = 'Muninn is a local-first Markdown vault with [[wikilinks]] and a knowledge graph. Every note is a plain file you can read, move, diff, and version-control. MIT licensed.';
const DEFAULT_OG_DESCRIPTION = 'A local-first Markdown vault with [[wikilinks]] and a knowledge graph.';
const DEFAULT_OG_IMAGE = '/assets/og.png';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogTitle = title === DEFAULT_TITLE ? 'Muninn' : title,
  ogDescription = DEFAULT_OG_DESCRIPTION,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = 'Muninn logo and the words “Muninn — a local-first Markdown vault with a knowledge graph.”',
} = Astro.props;

const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${SITE_ORIGIN}${ogImage}`;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#080808" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content={ogType}>
  <meta property="og:image" content={ogImageAbs}>
  <meta property="og:image:alt" content={ogImageAlt}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  <meta name="twitter:image" content={ogImageAbs}>
  <meta name="twitter:image:alt" content={ogImageAlt}>
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/InterVariable-latin.woff2" as="font" type="font/woff2" crossorigin>
  <script is:inline>
    // First paint: saved choice, else the system appearance, else dark.
    (function () {
      var t = null;
      try { t = localStorage.getItem('muninn-theme'); } catch (e) {}
      if (t !== 'dark' && t !== 'light') {
        t = window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      }
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <script is:inline defer src="https://umami-app.ravenwoodsoftware.dev/script.js" data-website-id="e9a78bed-e335-420a-8b40-99e4d9f45e2f"></script>
  <script>
    import '../scripts/main.js';
  </script>
</head>
<body>
  <slot />
</body>
</html>
