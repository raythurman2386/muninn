---
// Shared site footer. The Privacy link points at the /privacy/ page rendered
// from PRIVACY.md; the visible text is unchanged from the W1 landing page.
// The Early access item is included only when PUBLIC_WAITLIST_ENABLED=true, so
// a default build stays byte-identical to main.
import { WAITLIST_ENABLED } from '../lib/waitlist';
---
  <footer class="site-footer">
    <div class="wrap footer-row">
      <p class="footer-brand"><img src="/assets/logo.svg" alt="" width="18" height="18"> Muninn · Ravenwood Software</p>
      <ul class="footer-links">
        <li><a href="https://github.com/raythurman2386/muninn">GitHub</a></li>
        <li><a href="https://github.com/raythurman2386/muninn/blob/main/LICENSE">MIT License</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/sponsor/">Sponsor</a></li>
        <li><a href="/press/">Press</a></li>
        {WAITLIST_ENABLED && <li><a href="/waitlist/">Early access</a></li>}
      </ul>
      <p class="credit">Built with <a href="https://github.com/anomalyco/rune">Rune</a></p>
    </div>
  </footer>
