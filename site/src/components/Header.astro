---
// Shared site header. `home` keeps the landing-page fragment links (#top, #features)
// so the home markup stays pixel-identical to the W1 port.
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const brandHref = home ? '#top' : '/';
const brandLabel = home ? 'Muninn, back to top' : 'Muninn, home';
const featuresHref = home ? '#features' : '/#features';
const downloadHref = home ? '#download' : '/#download';
---
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href={brandHref} aria-label={brandLabel}>
        <img src="/assets/logo.svg" alt="" width="28" height="28">
        <span>Muninn</span>
      </a>
      <nav aria-label="Primary">
        <ul class="nav">
          <li><a href={featuresHref}>Features</a></li>
          <li><a href={downloadHref}>Download</a></li>
          <li><a href="https://github.com/raythurman2386/muninn">GitHub</a></li>
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Use light theme">
        <svg class="i-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 1.75v2M10 16.25v2M1.75 10h2M16.25 10h2M4.17 4.17l1.41 1.41M14.42 14.42l1.41 1.41M4.17 15.83l1.41-1.41M14.42 5.58l1.41-1.41" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <svg class="i-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M16.5 12.2A6.75 6.75 0 0 1 7.8 3.5a6.75 6.75 0 1 0 8.7 8.7Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span class="toggle-label">Light</span>
      </button>
    </div>
  </header>
