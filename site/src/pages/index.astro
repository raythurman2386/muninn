---
// Home: hero tour, three pillars (Notes and graph, Board, Kanban), and the
// local-first pitch. Board and Kanban media are the W6 v0.8.2 captures.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeStill from '../components/ThemeStill.astro';
import { OG } from '../lib/og';

const stillSizes = '(max-width: 899px) calc(100vw - 32px), 360px';
---
<Base ogImage={OG.home.image} ogImageAlt={OG.home.alt}>
  <a class="skip" href="#main">Skip to content</a>
  <Header home />

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="wrap hero-copy">
        <p class="eyebrow">Local-first notes</p>
        <h1 id="hero-title">Your notes are files.<br><span class="soft">Muninn remembers the links.</span></h1>
        <p class="lede">A Markdown vault with <code>[[wikilinks]]</code> and a knowledge graph. Every note is a plain <code>.md</code> file in a folder you choose, so you can read, move, diff, and version-control it with the tools you already use.</p>

        <div class="cta" id="download">
          <ul class="downloads" aria-describedby="dl-note">
            <li><a class="dl" href="https://github.com/raythurman2386/muninn/releases/latest" aria-label="Download for Linux, x86_64 .deb or tar.gz, from GitHub Releases"><span class="dl-os">Linux</span><span class="dl-state">x86_64</span></a></li>
            <li><a class="dl" href="https://github.com/raythurman2386/muninn/releases/latest" aria-label="Download for macOS, Apple Silicon only, from GitHub Releases"><span class="dl-os">macOS</span><span class="dl-state">Apple Silicon</span></a></li>
            <li><a class="dl" href="https://github.com/raythurman2386/muninn/releases/latest" aria-label="Download for Windows, x86_64 zip, from GitHub Releases"><span class="dl-os">Windows</span><span class="dl-state">x86_64</span></a></li>
          </ul>
          <a class="btn btn-primary" href="https://github.com/raythurman2386/muninn">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
            View source on GitHub
          </a>
        </div>
        <p class="dl-note" id="dl-note">Downloads come from the latest <a href="https://github.com/raythurman2386/muninn/releases/latest"><span class="nowrap">GitHub Release</span></a>: Linux x86_64 (<code>.deb</code> and <code>.tar.gz</code>), macOS on Apple Silicon only (<code>.tar.gz</code>), and Windows x86_64 (<code>.zip</code>). On anything else, <a href="https://github.com/raythurman2386/muninn#quick-start">build it from source</a>.</p>
      </div>

      <div class="wrap wrap-wide">
        <figure class="hero-media frame">
          <div class="media" data-hero>
            <!-- Still first; main.js swaps in the loop only when motion is allowed. -->
            <img class="hero-still only-dark" src="/assets/img/dark/preview-1600.webp" width="1600" height="1058" alt="Muninn in Read mode: the note “Launch Checklist” open in the middle, the note list on the left, and outgoing links and backlinks on the right.">
            <img class="hero-still only-light" src="/assets/img/light/preview-1600.webp" width="1600" height="1058" alt="Muninn in Read mode, light theme: the note “Launch Checklist” with its note list, outgoing links, and backlinks." loading="lazy">
          </div>
          <figcaption>
            <span>Read a note, search, glide the graph, then open Board and Kanban.</span>
            <button class="motion-toggle" type="button" hidden aria-pressed="false">Pause</button>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="pillars" id="features" aria-labelledby="pillars-title">
      <div class="wrap">
        <h2 id="pillars-title" class="section-title">Notes, a board, and a kanban. Same vault.</h2>
        <p class="pillars-lede">Write and read Markdown, sketch on a whiteboard, or move work across lanes. Every view is a file in the folder you choose.</p>
      </div>
      <ul class="pillar-grid wrap wrap-wide">
        <li class="pillar-card">
          <div>
            <h3>Notes and graph</h3>
            <p>Write, Read, and Graph are three views of the same note. <code>[[Wikilinks]]</code> become edges; the local graph keeps only the neighbours of the open note.</p>
            <a class="pillar-link" href="/features/">Explore features</a>
          </div>
          <figure class="frame">
            <ThemeStill
              scene="editor"
              width={1600}
              height={1000}
              widths={[960, 1600]}
              sizes={stillSizes}
              alt="Muninn in Write mode: the Markdown source of “Product Roadmap” in the middle, the Tidepool note list on the left, and outgoing links and backlinks on the right."
              altLight="Muninn in Write mode, light theme: the Markdown source of “Product Roadmap”, with the note list and links rail."
            />
          </figure>
        </li>
        <li class="pillar-card">
          <div>
            <h3>Board</h3>
            <p>An <code>.excalidraw</code> whiteboard next to your notes. Pick a stroke colour, draw cards and arrows, and label them in place.</p>
            <a class="pillar-link" href="/features/board/">See Board</a>
          </div>
          <figure class="frame">
            <ThemeStill
              scene="board-drawn"
              width={1600}
              height={1000}
              widths={[960, 1600]}
              sizes={stillSizes}
              alt="The Launch Plan board in Muninn: the Tidepool 1.0 launch-plan diagram, with coloured outline cards, a red ink circle around “Launch day Dec 2”, and an arrow pointing at Retro."
              altLight="The Launch Plan board in the light theme: the Tidepool 1.0 launch-plan diagram, with coloured outline cards, a red ink circle around “Launch day Dec 2”, and an arrow pointing at Retro."
            />
          </figure>
        </li>
        <li class="pillar-card">
          <div>
            <h3>Kanban</h3>
            <p>A kanban note with lanes and cards that live in the vault. Drag a card into Done and it is marked complete.</p>
            <a class="pillar-link" href="/features/kanban/">See Kanban</a>
          </div>
          <figure class="frame">
            <ThemeStill
              scene="kanban-lanes"
              width={1160}
              height={620}
              widths={[696, 1160]}
              sizes={stillSizes}
              alt="The Launch Week kanban in Muninn, showing three lanes: To do, Doing, and Done, with cards for screenshots, the launch post, and completed onboarding work."
              altLight="The Launch Week kanban in the light theme, showing three lanes: To do, Doing, and Done."
            />
          </figure>
        </li>
      </ul>
    </section>

    <section class="features" aria-labelledby="features-title">
      <div class="wrap">
        <h2 id="features-title" class="section-title">Small on purpose.</h2>
        <ul class="feature-grid">
          <li>
            <h3>Files, not a database</h3>
            <p>A folder of <code>.md</code> files is the whole vault. Open it in any editor, sync it however you like, keep it in Git.</p>
          </li>
          <li>
            <h3><code>[[Wikilinks]]</code> that resolve</h3>
            <p><code>[[Note]]</code>, <code>[[Note|alias]]</code>, and <code>[[Note#heading]]</code>. Clicking an unresolved link creates the note.</p>
          </li>
          <li>
            <h3>Keyboard-complete</h3>
            <p>Search with <kbd>⌘K</kbd>, the command palette with <kbd>⌘⇧P</kbd>, and arrow keys through the graph. <kbd>Ctrl</kbd> on Linux and Windows.</p>
          </li>
          <li>
            <h3>Sync is optional</h3>
            <p>Off until you connect Google Drive, a GitHub repository, or a device on your Tailscale network. No Muninn account. <a href="/privacy/">Privacy</a></p>
          </li>
        </ul>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="wrap closing-inner">
        <img src="/assets/logo.svg" alt="" width="56" height="56">
        <h2 id="closing-title">Remember what you write.</h2>
        <p>Muninn is free and open source under the MIT license. Builds for Linux, macOS (Apple Silicon), and Windows are on <a href="https://github.com/raythurman2386/muninn/releases/latest">GitHub Releases</a>.</p>
        <a class="btn btn-primary" href="https://github.com/raythurman2386/muninn">View source on GitHub</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
