---
// /sponsor/ is a simple support page. The GitHub Sponsors profile for
// raythurman2386 was confirmed live (HTTP 200 at https://github.com/sponsors/raythurman2386,
// title "Sponsor @raythurman2386") on 14 Nov 2026. Buy Me a Coffee is listed
// in .github/FUNDING.yml. There is no payment form on this page.
import Base from '../layouts/Base.astro';
import { OG } from '../lib/og';
import '../styles/pages.css';

const sponsorsUrl = 'https://github.com/sponsors/raythurman2386';
const coffeeUrl = 'https://buymeacoffee.com/raythurman';
const sourceUrl = 'https://github.com/raythurman2386/muninn';
---
<Base
  title="Sponsor — Muninn"
  description="Support Muninn's development through GitHub Sponsors or Buy Me a Coffee. Muninn is free and MIT-licensed."
  ogTitle="Sponsor — Muninn"
  ogDescription="Support Muninn's development through GitHub Sponsors or Buy Me a Coffee."
  ogImage={OG.sponsor.image}
  ogImageAlt={OG.sponsor.alt}
>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="/" aria-label="Muninn, home">
        <img src="/assets/logo.svg" alt="" width="28" height="28">
        <span>Muninn</span>
      </a>
      <nav aria-label="Primary">
        <ul class="nav">
          <li><a href="/#features">Features</a></li>
          <li><a href="/#download">Download</a></li>
          <li><a href="https://github.com/raythurman2386/muninn">GitHub</a></li>
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Use light theme">
        <svg class="i-sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 1.75v2M10 16.25v2M1.75 10h2M16.25 10h2M4.17 4.17l1.41 1.41M14.42 14.42l1.41 1.41M4.17 15.83l1.41-1.41M14.42 5.58l1.41-1.41" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <svg class="i-moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M16.5 12.2A6.75 6.75 0 0 1 7.8 3.5a6.75 6.75 0 1 0 8.7 8.7Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span class="toggle-label">Light</span>
      </button>
    </div>
  </header>

  <main id="main" class="simple-page">
    <div class="wrap simple-inner">
      <h1>Sponsor Muninn</h1>
      <p class="lede">Muninn is free and open source under the MIT license. If you want to support the work, these are the two places listed in the project's funding file.</p>

      <div class="cta-row">
        <a class="btn btn-primary" href={sponsorsUrl}>Sponsor on GitHub</a>
        <a class="btn btn-secondary" href={coffeeUrl}>Buy Me a Coffee</a>
      </div>

      <h2>Where it goes</h2>
      <p>There is no paid product and no sponsor tier on this site. Contributions help cover the time spent on the app and the cost of running the website and related services. Nothing here is required to download or use Muninn.</p>
      <p>You can also <a href={sourceUrl}>star the repository</a> or <a href="https://github.com/raythurman2386/muninn/blob/main/CONTRIBUTING.md">contribute a change</a>.</p>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <p class="footer-brand"><img src="/assets/logo.svg" alt="" width="18" height="18"> Muninn · Ravenwood Software</p>
      <ul class="footer-links">
        <li><a href="https://github.com/raythurman2386/muninn">GitHub</a></li>
        <li><a href="https://github.com/raythurman2386/muninn/blob/main/LICENSE">MIT License</a></li>
        <li><a href="https://github.com/raythurman2386/muninn/blob/main/PRIVACY.md">Privacy</a></li>
        <li><a href="/sponsor/" aria-current="page">Sponsor</a></li>
        <li><a href="/press/">Press</a></li>
      </ul>
      <p class="credit">Built with <a href="https://github.com/anomalyco/rune">Rune</a></p>
    </div>
  </footer>
</Base>
